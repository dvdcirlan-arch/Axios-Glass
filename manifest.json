{
  "manifest_version": 3,
  "name": "Axios Glass — Registro Elettronico",
  "short_name": "Axios Glass",
  "version": "2.1.1",
  "description": "Nuova interfaccia pastel-glass per il Registro Elettronico Axios Famiglie. Legge i dati reali dal DOM, senza modificarlo.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://registrofamiglie.axioscloud.it/*",
        "https://*.axioscloud.it/*"
      ],
      "css": ["styles.css"],
      "js": ["core.js", "ui.js", "scraper.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
